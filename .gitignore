# See https://help.github.com/articles/ignoring-files/

# Secrets - NEVER commit these
.env*
!.env.example
*.pem
*.key

# Dependencies
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# Production build
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Uploaded files - live on disk, backed up separately, NEVER in git
/public/uploads

# OS / editor junk
.DS_Store
Thumbs.db